NODE_ENV=development
PORT=3000

# Comma-separated allowlist. Add local development origins only when needed.
CORS_ORIGINS=https://saku-pas.vercel.app

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_MAX=5

# Optional Neon connection string; when set it takes precedence over DB_*.
DATABASE_URL=

# 0 allows tokens to remain non-expiring.
TOKEN_EXPIRATION_MINUTES=0
